<?xml version="1.0"?>
<package format="3">
  <name>piper_drawing</name><version>0.1.0</version>
  <description>复用 Piper 官方模型、SDK 和 KDL 的无头绘画</description>
  <maintainer email="local@example.com">Piper 用户</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>std_srvs</depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend>
  <depend>moveit_ros_planning_interface</depend><depend>moveit_core</depend>
  <depend>moveit_msgs</depend><depend>tf2_eigen</depend><depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>piper_description</exec_depend><exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>controller_manager</exec_depend><exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
